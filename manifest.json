{
  "manifest_version": 3,
  "name": "蝰蛇音效 Pro",
  "plugin_id": "viper-fx",
  "version": "2.0.0",
  "description": "模块化专业音效引擎：10段全参数EQ、谐波低音增强、激励/饱和、压缩/真峰限幅、卷积混响(可导入自定义IR)、M/S立体声场、实时频谱、智能自动调音与响度匹配、预设生态(JSON导入导出/自定义预设/A-B)。基于 Web Audio 实时 DSP。",
  "moekoe": true,
  "minversion": "1.7.0",
  "author": {
    "name": "SHIYI",
    "url": "https://github.com/MoeKoeMusic/MoeKoeMusic"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "world": "MAIN",
      "js": [
        "viper-fx.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  }
}
